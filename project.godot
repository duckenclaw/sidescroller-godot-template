; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Sidescroller Godot Template"
config/description="A 2D sidescroller starter built on the shared Godot game kits."
config/tags=PackedStringArray("2d", "platformer")
run/main_scene="res://src/levels/demo_level.tscn"
config/features=PackedStringArray("4.8", "GL Compatibility")
config/icon="res://assets/sprites/duckclaw.png"

[autoload]

EventBus="*res://addons/core/event_bus.gd"
GameSettings="*res://src/globals/game_settings.gd"
SceneManager="*res://addons/core/scene_manager.gd"
AudioManager="*res://addons/core/audio_manager.gd"
SaveManager="*res://addons/core/save_manager.gd"
Localization="*res://addons/core/localization.gd"
Debug="*res://addons/core/debug_overlay.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/core/plugin.cfg", "res://addons/settings_kit/plugin.cfg", "res://addons/inventory_kit/plugin.cfg", "res://addons/components_kit/plugin.cfg", "res://addons/platformer_controller_2d/plugin.cfg")

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
